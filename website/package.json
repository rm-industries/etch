{
  "name": "etch-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate:build": "node scripts/validate-build.ts",
    "astro": "astro",
    "astro:check": "astro check",
    "audit": "audit-ci --config audit-ci.jsonc",
    "audit:unused": "knip",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "npm run lint:code && npm run lint:css && npm run lint:markdown && npm run spellcheck",
    "lint:code": "oxlint",
    "lint:code:fix": "oxlint --fix",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "lint:css:fix": "stylelint --fix \"**/*.css\" --ignore-path .gitignore",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore-path .gitignore && markdownlint \"../docs/guides/**/*.md\"",
    "lint:markdown:fix": "markdownlint --fix \"**/*.md\" --ignore-path .gitignore",
    "lighthouse:autorun": "lhci autorun",
    "lighthouse:ci": "node scripts/run-lighthouse.ts",
    "spellcheck": "cspell \"**\" \"../docs/guides/**/*.md\"",
    "typecheck": "astro check",
    "test": "npm run test:unit",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:unit": "vitest run",
    "quality": "npm run quality:core && npm run test:e2e && npm run lighthouse:ci",
    "quality:core": "npm run quality:static && npm run test:coverage && npm run build && npm run validate:build",
    "quality:static": "npm run format && npm run lint && npm run audit:unused && npm run typecheck",
    "quality:static:ci": "npm run lint:code && npm run lint:css && npm run lint:markdown && npm run audit:unused && npm run typecheck"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@rm-industries/content-model": "1.1.1",
    "@sveltia/cms": "0.212.2",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@catppuccin/daisyui": "^2.1.1",
    "@catppuccin/palette": "^1.8.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "audit-ci": "7.1.0",
    "cspell": "^10.3.3",
    "daisyui": "^5.7.42",
    "knip": "^6.36.0",
    "markdownlint-cli": "^0.49.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || ^26.0.0",
    "npm": "^10.9.0 || ^11.0.0"
  },
  "packageManager": "npm@11.19.0"
}
