---
import Terminal from './Terminal.astro';
---

<figure class="min-w-0" aria-label="Illustrative Etch plan for a developer profile">
  <Terminal>
    <pre data-prefix="$"><code><span class="terminal-command">./etch</span> <span class="terminal-argument">plan</span> <span class="terminal-option">--profile</span> <span class="terminal-argument">developer</span></code></pre>
    <pre data-prefix=" "><code> </code></pre>
    <pre data-prefix=" "><code>Profile: <span class="terminal-argument">developer</span></code></pre>
    <pre data-prefix=" "><code> </code></pre>
    <pre data-prefix="+"><code>git · <span class="terminal-option">1 planned change</span></code></pre>
    <pre data-prefix=" "><code>files/gitconfig → ~/.gitconfig</code></pre>
    <pre data-prefix=" "><code> </code></pre>
    <pre data-prefix="→"><code>Review first. Apply when ready.</code></pre>
    <pre data-prefix=" " class="terminal-command"><code>Nothing changed yet.</code></pre>
  </Terminal>
  <figcaption class="mt-3 flex flex-wrap justify-between gap-4 font-mono text-sm"><span>An illustrative plan</span><span>Your configuration, made explicit.</span></figcaption>
</figure>
